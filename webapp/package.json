{
  "name": "mattermost-plugin-webrtc-video",
  "version": "2.1.0",
  "private": true,
  "description": "Frontend for the WebRTC peer-to-peer video and voice call plugin.",
  "main": "src/index.jsx",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "webpack --mode=production",
    "build:watch": "webpack --mode=production --watch",
    "debug": "webpack --mode=none",
    "lint": "eslint --quiet .",
    "fix": "eslint --quiet --fix .",
    "test": "jest --forceExit --detectOpenHandles --verbose"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "mattermost-redux": "11.9.0",
    "prop-types": "^15.8.1",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost:8065"
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ]
  }
}
